    \draw[ar] (S3)--(ILP); \draw[ar] (VC)--(ILP); \draw[ar] (VC)--(ST);
    \draw[ar] (ONE)--(SS); \draw[ar] (SS)--(PAR); \draw[ar] (SS)--(KN); \draw[ar] (TP)--(BP);
    % popisky rodin
    \node[font=\sffamily\scriptsize,defc] at (-1.2,-4.7) {pořadí (sekvence)};
    \node[font=\sffamily\scriptsize,thmc] at (2.6,-2.3) {rovnice};
    \node[font=\sffamily\scriptsize,exc] at (5.6,-2.3) {sítě};
    \node[font=\sffamily\scriptsize,intc!80!black] at (11.4,-3.6) {čísla};
    \node[font=\sffamily\tiny,gr,align=center] at (14.0,-0.6) {Garey, Johnson\\ (bez důkazu)};

