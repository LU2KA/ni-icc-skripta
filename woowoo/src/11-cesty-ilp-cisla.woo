    % cisla
    \node[pc] (SS)  at (10.4,-1.4) {Subset Sum};
    \node[pc] (PAR) at (8.9,-2.8)  {Partition};
    \node[pc] (KN)  at (11.9,-2.8) {Knapsack};
    \node[pc] (TP)  at (14.0,-1.4) {3-Partition};
