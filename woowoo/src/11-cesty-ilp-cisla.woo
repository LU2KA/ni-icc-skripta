    filename: 11-cesty-ilp-cisla-01
    options: 'x=1cm,y=1cm, pn/.style={draw,rounded corners=3pt,thick,font=\sffamily\scriptsize\bfseries,inner sep=3pt, minimum height=6mm,align=center,fill=white}, pz/.style={pn,draw=gr,fill=black!6}, ps/.style={pn,draw=defc,fill=defc!8}, pr/.style={pn,draw=thmc,fill=thmc!8}, pi/.style={pn,draw=exc,fill=exc!10}, pc/.style={pn,draw=intc,fill=intc!14}, ar/.style={->,thick,draw=black!65}'
    include_options: 'width=\linewidth'

