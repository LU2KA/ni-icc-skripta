    \node[v] (d) at (3.8,0.7) {d}; \node[v] (e) at (4.8,0.7) {e}; \node[v] (f) at (6.5,0.7) {f};
    \draw[->,thick] (a)--(b); \draw[->,thick] (b)--(c); \draw[->,thick] (c)--(a);
    \draw[->,thick] (b) to[bend left=10] (d); \draw[->,thick] (d) to[bend left=25] (e); \draw[->,thick] (e) to[bend left=25] (d);
    \draw[->,thick] (e)--(f); \draw[->,thick] (c) to[bend right=20] (d);
