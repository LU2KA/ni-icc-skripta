      \node[st,minimum size=6mm,font=\tiny] (b) at (0.9,0.6) {$q_1$};
      \node[stacc,minimum size=6mm,font=\tiny] (c) at (0.6,-1.0) {$q_A$};
      \draw[tr,thin] (a)--(b); \draw[tr,thin] (b)--(c); \draw[tr,thin] (a)--(c);
    \end{scope}
    % 2 tabulka
    \node[blokd,minimum width=25mm,minimum height=27mm,right=of m] (t) {};
    \node[font=\small\bfseries,anchor=north] at (t.north) {tabulka};
    \begin{scope}[shift={($(t.center)+(-0.9,-0.95)$)}]
      \draw[step=0.3,black!40] (0,0) grid (1.8,1.5);
      \fill[hl] (0.6,1.2) rectangle (0.9,1.5); \fill[hl] (0.9,0.9) rectangle (1.2,1.2);
      \fill[hl] (0.6,0.6) rectangle (0.9,0.9); \fill[hl] (0.9,0.3) rectangle (1.2,0.6);
      \fill[hl] (1.2,0) rectangle (1.5,0.3);
      \draw[step=0.3,black!40] (0,0) grid (1.8,1.5);
    \end{scope}
    % 3 dlazdice
    \node[blokd,minimum width=25mm,minimum height=27mm,right=of t] (d) {};
    \node[font=\small\bfseries,anchor=north] at (d.north) {dlaždice};
    \begin{scope}[shift={($(d.center)+(-0.9,-1.0)$)},scale=0.6]
      \chRA{0}{1}\chRB{1}{1}\chRC{2}{1}
