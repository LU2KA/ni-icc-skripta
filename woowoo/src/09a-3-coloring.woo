    \node[chZv] (b) at (-1.1,0.9) {};
    \node[chZv] (c) at (-1.8,0.3) {};
    \node[chZv] (d) at (-0.6,-0.4) {};
    \node[chZv] (ee) at (0.5,-0.4) {};
