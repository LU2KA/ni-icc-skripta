      \node[dpcell] at (2.80,-3.30) {4};
      \node[dpcell] at (3.60,-3.30) {5};
      \node[dpskip] at (4.40,-3.30) {7};
      \node[dpcell] at (5.20,-3.30) {8};
      \node[font=\scriptsize,anchor=east] at (-0.1,-4.30) {$4$: $(1,2)$};
      \node[dpcell] at (0.40,-4.30) {0};
