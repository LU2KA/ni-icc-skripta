    \fill[thmc!7,draw=thmc,thick] (0,2.2) ellipse (5.9 and 2.55);
    \node[font=\sffamily\bfseries\small,thmc,align=center] at (0,4.25) {$\PSPACE=\NPSPACE$};
    \node[font=\scriptsize,thmc,align=center] at (4.65,2.35) {TQBF, GG,\\ Sokoban, Hex};
    \fill[defc!7,draw=defc,thick] (-0.8,1.75) ellipse (4.2 and 1.95);
    \node[font=\sffamily\bfseries,defc] at (-0.8,3.35) {\NP};
    \fill[warnc!15,draw=warnc,thick] (2.0,1.8) ellipse (1.05 and 0.75);
    \node[font=\scriptsize\bfseries,warnc,align=center] at (2.0,1.8) {NP-úplné\\ \tiny SAT, TSP};
    \fill[exc!12,draw=exc,thick] (-2.1,1.45) ellipse (2.4 and 1.35);
    \node[font=\sffamily\bfseries,exc] at (-2.1,2.45) {\PP};
